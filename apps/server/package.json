{
  "name": "@social-cleanup/server",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "LOCAL_DEV_BYPASS=true FAKE_ADAPTERS=true tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@social-cleanup/shared": "0.1.0",
    "fastify": "^5.3.2",
    "zod": "^3.24.2"
  },
  "devDependencies": { "@types/node": "^22.15.3" }
}
